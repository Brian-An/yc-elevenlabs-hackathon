datasource db {
  provider = "postgresql"
  // Wasp requires that the url is set to the DATABASE_URL environment variable.
  url      = env("DATABASE_URL")
}

// Wasp requires the `prisma-client-js` generator to be present.
generator client {
  provider = "prisma-client-js"
}

// PostgreSQL is the single source of truth for user memory.
// Json columns are typed in src/server/dto.ts and read through src/server/serialize.ts.

// There is no login. The id is a UUID the browser generates and keeps in localStorage.
model User {
  id              String        @id
  createdAt       DateTime      @default(now())
  displayName     String?
  goals           String?
  experienceLevel String? // "beginner" | "intermediate" | "experienced"
  preferences     Json          @default("{}") // Preferences: { personality: string[], dateSetting: string, ... }
  onboardedAt     DateTime?
  sessions        DateSession[]
  memory          UserMemory?
  callbacks       PersonaCallback[]
}

model DateSession {
  id         String    @id @default(uuid())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  personaId  String
  kind       String // "date" | "coaching"
  source     String // "live" | "demo" | "legacy"
  scenario   Json // Scenario
  status     String    @default("active") // "active" | "ended" | "evaluated"
  transcript Json      @default("[]") // Transcript
  evaluation Json? // Evaluation for historical sessions
  review     Json? // DateReview, grounded in the frozen transcript
  reviewStatus String @default("none") // ReviewStatus in src/server/dto.ts
  // Denormalized from the transcript and review so history lists never read either column.
  turnCount    Int   @default(0)
  replyCount   Int   @default(0)
  reviewScores Json? // ReviewScores, set with the review
  coachSourceSessionId String?
  // A detail the user shared on their last date with this persona, passed to the agent as {{user_context}}.
  userContext String?
  startedAt  DateTime  @default(now())
  endedAt    DateTime?
  moves      Move[]
  reviewJobs ReviewJob[]

  @@index([userId, startedAt])
  @@index([userId, kind, source, reviewStatus, endedAt])
}

// Jev's grade for one user turn of a date (MoveEvaluation in src/shared/types.ts).
model Move {
  id             String      @id @default(uuid())
  session        DateSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId      String
  turnIndex      Int
  inputHash      String      @default("") // Empty for grades saved before input tracking.
  decision       Json? // Raw Jev label and probabilities for calibration.
  classification String // MoveClass
  confidence     Float
  scores         Json // Record<SkillName, number>, 1–10
  createdAt      DateTime    @default(now())

  @@unique([sessionId, turnIndex, inputHash])
}

// The durable queue entry for one whole-date review. PgBoss only wakes workers, and a periodic sweep
// recovers lost wake-ups and expired leases. Metrics never include dialogue.
model ReviewJob {
  id             String      @id @default(uuid())
  session        DateSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId      String
  transcriptHash String
  rubricVersion  String
  status         String      @default("queued") // "queued" | "running" | "succeeded" | "failed"
  attempts       Int         @default(0)
  maxAttempts    Int
  runAfter       DateTime    @default(now())
  leaseToken     String?
  leaseExpiresAt DateTime?
  failureClass   String? // ReviewFailureClass of the latest failed attempt
  latencyMs      Int? // provider latency of the latest attempt that reached the provider
  inputTokens    Int     @default(0) // summed over attempts
  outputTokens   Int     @default(0)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  finishedAt     DateTime?

  @@unique([sessionId, transcriptHash, rubricVersion])
  @@index([status, runAfter])
}

// What the coach remembers about a user, updated after every evaluated date.
model UserMemory {
  id            Int      @id @default(autoincrement())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String   @unique
  skillProfile  Json     @default("{}") // SkillProfile: SkillName -> 0..1, rolling average of recent sessions
  trainingFocus String? // SkillName the next date should target (weakest skill)
  strengths     Json     @default("[]") // MemoryPoint[]
  weaknesses    Json     @default("[]") // MemoryPoint[]
  skillHistory  Json     @default("[]") // SkillHistoryEntry[]
  sessionsCount Int      @default(0)
  updatedAt     DateTime @updatedAt
}

// One thing the user explicitly shared on a date (e.g. "I'm taking a pottery class on Saturday"),
// so the next date with the same persona can follow up on it. One per user + persona; a newer detail replaces it.
model PersonaCallback {
  id              Int      @id @default(autoincrement())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String
  personaId       String
  detail          String
  sourceSessionId String // the date it came from
  usedInSessionId String? // the date that followed up on it; null until then
  createdAt       DateTime @default(now())

  @@unique([userId, personaId])
}
