datasource db {
  provider = "postgresql"
  // Wasp requires that the url is set to the DATABASE_URL environment variable.
  url      = env("DATABASE_URL")
}

// Wasp requires the `prisma-client-js` generator to be present.
generator client {
  provider = "prisma-client-js"
}

// PostgreSQL is the single source of truth for user memory.
// Json columns are typed in src/server/dto.ts and read through src/server/serialize.ts.

// There is no login. The id is a UUID the browser generates and keeps in localStorage.
model User {
  id              String        @id
  createdAt       DateTime      @default(now())
  displayName     String?
  goals           String?
  experienceLevel String? // "beginner" | "intermediate" | "experienced"
  preferences     Json          @default("{}") // Preferences: { personality: string[], dateSetting: string, ... }
  onboardedAt     DateTime?
  sessions        DateSession[]
  memory          UserMemory?
}

model DateSession {
  id         String    @id @default(uuid())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  personaId  String
  scenario   Json // Scenario
  status     String    @default("active") // "active" | "ended" | "evaluated"
  transcript Json      @default("[]") // Transcript
  evaluation Json? // Evaluation
  startedAt  DateTime  @default(now())
  endedAt    DateTime?

  @@index([userId, startedAt])
}

// What the coach remembers about a user, updated after every evaluated date.
model UserMemory {
  id            Int      @id @default(autoincrement())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String   @unique
  skillProfile  Json     @default("{}") // SkillProfile: SkillName -> 0..1, rolling average of recent sessions
  trainingFocus String? // SkillName the next date should target (weakest skill)
  strengths     Json     @default("[]") // MemoryPoint[]
  weaknesses    Json     @default("[]") // MemoryPoint[]
  skillHistory  Json     @default("[]") // SkillHistoryEntry[]
  sessionsCount Int      @default(0)
  updatedAt     DateTime @updatedAt
}
