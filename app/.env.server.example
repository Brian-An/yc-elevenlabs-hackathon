# Copy to .env.server and fill in. Never commit real values.

# PostgreSQL. Leave unset to use the dev database from `wasp start db` (needs Docker),
# or point it at any Postgres, e.g. a local Homebrew install:
# DATABASE_URL=postgresql://<your-macos-user>@localhost:5432/dating_sandbox

# ElevenLabs Conversational AI. `node scripts/elevenlabs-agents.mjs` creates the agents and fills in every agent ID below.
ELEVENLABS_API_KEY=
# Default agent, for any persona without its own
ELEVENLABS_AGENT_ID=
# Per-persona agents (exposed as persona.elevenLabsAgentId by getPersonas)
ELEVENLABS_AGENT_ID_MAYA=
ELEVENLABS_AGENT_ID_THEO=
ELEVENLABS_AGENT_ID_PRIYA=
ELEVENLABS_AGENT_ID_COACH=
# Agent for characters users generate, with the voice override enabled
ELEVENLABS_AGENT_ID_CUSTOM=

# TypeSafe Jev grades each user reply during a date (console.typesafe.ai/keys).
TYPESAFE_API_KEY=

# Anthropic reviews the complete transcript after a practice date.
ANTHROPIC_API_KEY=
# ANTHROPIC_REVIEW_MODEL=claude-sonnet-4-6
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# Model that writes generated characters and describes avatar previews.
# ANTHROPIC_CHARACTER_MODEL=claude-opus-5-5

# Anam video avatars (real-time lip-synced video). Anam's engine joins the ElevenLabs agent through a signed URL,
# so it uses ELEVENLABS_API_KEY above. Keys: https://lab.anam.ai, Avatars: https://lab.anam.ai/avatars
ANAM_API_KEY=
# Fallback avatar when a persona has no ANAM_AVATAR_ID_<PERSONA> of its own. Video is off until this is set.
ANAM_AVATAR_ID=
# Optional per-persona avatars
ANAM_AVATAR_ID_MAYA=
ANAM_AVATAR_ID_THEO=
ANAM_AVATAR_ID_PRIYA=
ANAM_AVATAR_ID_COACH=
