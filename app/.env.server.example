# Copy to .env.server and fill in. Never commit real values.

# ElevenLabs Conversational AI
ELEVENLABS_API_KEY=
# Default agent used by GET /api/elevenlabs/signed-url when no ?agentId= is given
ELEVENLABS_AGENT_ID=
# Optional per-persona agents (exposed as persona.elevenLabsAgentId by getPersonas)
ELEVENLABS_AGENT_ID_MAYA=
ELEVENLABS_AGENT_ID_THEO=
ELEVENLABS_AGENT_ID_PRIYA=

# Rowboat memory (optional; local UserMemory table is used when unset)
ROWBOAT_API_KEY=
ROWBOAT_PROJECT_ID=
# ROWBOAT_API_HOST=https://api.rowboatlabs.com
