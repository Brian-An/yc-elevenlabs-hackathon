# Copy to .env.server and fill in. Never commit real values.

# PostgreSQL. Leave unset to use the dev database from `wasp start db` (needs Docker),
# or point it at any Postgres, e.g. a local Homebrew install:
# DATABASE_URL=postgresql://<your-macos-user>@localhost:5432/dating_sandbox

# ElevenLabs Conversational AI
ELEVENLABS_API_KEY=
# Default agent used by GET /api/elevenlabs/signed-url when no ?agentId= is given
ELEVENLABS_AGENT_ID=
# Optional per-persona agents (exposed as persona.elevenLabsAgentId by getPersonas)
ELEVENLABS_AGENT_ID_MAYA=
ELEVENLABS_AGENT_ID_THEO=
ELEVENLABS_AGENT_ID_PRIYA=
ELEVENLABS_AGENT_ID_COACH=
# Agent for characters users generate. It needs the session template and the voice override enabled (see README).
ELEVENLABS_AGENT_ID_CUSTOM=

# TypeSafe Jev grades each user reply during a date (console.typesafe.ai/keys).
TYPESAFE_API_KEY=

# Anthropic reviews the complete transcript after a practice date.
ANTHROPIC_API_KEY=
# ANTHROPIC_REVIEW_MODEL=claude-sonnet-4-6
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# Model that writes generated characters and describes avatar previews.
# ANTHROPIC_CHARACTER_MODEL=claude-opus-5-5

# HeyGen LiveAvatar (real-time lip-synced video, connects to the ElevenLabs agent above server-side).
# Needs a paid ElevenLabs plan -- the ElevenLabs Agent Connector isn't available on the free tier.
HEYGEN_API_KEY=
# Fallback avatar when a persona has no HEYGEN_AVATAR_ID_<PERSONA> of its own.
HEYGEN_AVATAR_ID=
# Optional per-persona avatars from https://app.liveavatar.com.
HEYGEN_AVATAR_ID_MAYA=
HEYGEN_AVATAR_ID_THEO=
HEYGEN_AVATAR_ID_PRIYA=
HEYGEN_AVATAR_ID_COACH=
# From `POST https://api.liveavatar.com/v1/secrets` with secret_type ELEVENLABS_API_KEY (one-time setup, see src/server/heygen.ts).
HEYGEN_ELEVENLABS_SECRET_ID=
HEYGEN_IS_SANDBOX=true
